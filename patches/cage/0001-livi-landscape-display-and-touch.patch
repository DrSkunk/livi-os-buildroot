From: LIVI OS maintainers
Subject: [PATCH] Configure HDMI0 landscape and map kiosk touch on hotplug

Upstream-Status: Inappropriate [LIVI hardware configuration]

--- a/seat.c
+++ b/seat.c
@@ -137,6 +137,9 @@
 static void
 map_input_device_to_output(struct cg_seat *seat, struct wlr_input_device *device, const char *output_name)
 {
+	if (!output_name && device->type == WLR_INPUT_DEVICE_TOUCH) {
+		output_name = "HDMI-A-1";
+	}
 	if (!output_name) {
 		wlr_log(WLR_INFO, "Input device %s cannot be mapped to an output device\n", device->name);
 		return;
@@ -153,6 +156,15 @@
 	}
 
 	wlr_log(WLR_INFO, "Couldn't map input device %s to an output\n", device->name);
+}
+
+void
+seat_remap_touch(struct cg_seat *seat)
+{
+	struct cg_touch *touch;
+	wl_list_for_each (touch, &seat->touch, link) {
+		map_input_device_to_output(seat, &touch->touch->base, touch->touch->output_name);
+	}
 }
 
 static void
--- a/seat.h
+++ b/seat.h
@@ -91,6 +91,7 @@
 void seat_destroy(struct cg_seat *seat);
 struct cg_view *seat_get_focus(struct cg_seat *seat);
 void seat_set_focus(struct cg_seat *seat, struct cg_view *view);
+void seat_remap_touch(struct cg_seat *seat);
 void seat_center_cursor(struct cg_seat *seat);
 
 #endif
--- a/output.c
+++ b/output.c
@@ -13,6 +13,7 @@
 
 #include <assert.h>
 #include <stdlib.h>
+#include <string.h>
 #include <unistd.h>
 #include <wayland-server-core.h>
 #include <wlr/backend.h>
@@ -179,6 +180,7 @@
 {
 	struct cg_server *server = wl_container_of(listener, server, output_layout_change);
 
+	seat_remap_touch(server->seat);
 	view_position_all(server);
 	update_output_manager_config(server);
 }
@@ -244,6 +246,15 @@
 			wlr_drm_lease_v1_manager_offer_output(server->drm_lease_v1, wlr_output);
 		}
 #endif
+		return;
+	}
+
+	/* This kiosk has one physical display on HDMI0. */
+	if (strcmp(wlr_output->name, "HDMI-A-2") == 0) {
+		struct wlr_output_state disabled = {0};
+		wlr_output_state_set_enabled(&disabled, false);
+		wlr_output_commit_state(wlr_output, &disabled);
+		wlr_output_state_finish(&disabled);
 		return;
 	}
 
@@ -297,6 +308,20 @@
 				if (wlr_output_test_state(wlr_output, &state)) {
 					break;
 				}
+			}
+		}
+	}
+
+	/* Native scanout stays portrait; the desktop and mapped touch rotate together.
+	 * Apply on every hotplug, before the first frame, not only at app startup. */
+	if (strcmp(wlr_output->name, "HDMI-A-1") == 0) {
+		wlr_output_state_set_transform(&state, WL_OUTPUT_TRANSFORM_90);
+		wlr_output_state_set_scale(&state, 1.0f);
+		struct wlr_output_mode *mode;
+		wl_list_for_each (mode, &wlr_output->modes, link) {
+			if (mode->width == 400 && mode->height == 1280) {
+				wlr_output_state_set_mode(&state, mode);
+				break;
 			}
 		}
 	}
