CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
# The root SquashFS is LZ4: cheap to decompress, so library loads at boot stay fast.
CONFIG_SQUASHFS_LZ4=y
# The default single decompressor serializes parallel systemd startup reads.
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
# USB music (FAT32/exFAT) and offline OS updates (also ext4).
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_FUSE_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
# HDMI video and USB capacitive touch for the Waveshare 7.9inch HDMI LCD.
# CONFIG_DRM_PANEL_SIMPLE is not set
# CONFIG_DRM_PANEL_ILITEK_ILI9881C is not set
# CONFIG_DRM_PANEL_JDI_LT070ME05000 is not set
# CONFIG_DRM_PANEL_RASPBERRYPI_TOUCHSCREEN is not set
# CONFIG_DRM_PANEL_WAVESHARE_TOUCHSCREEN is not set
# CONFIG_DRM_PANEL_WAVESHARE_TOUCHSCREEN_V2 is not set
# CONFIG_DRM_TOSHIBA_TC358762 is not set
# CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_ATTINY is not set
# CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_V2 is not set
# CONFIG_REGULATOR_WAVESHARE_TOUCHSCREEN is not set
CONFIG_INPUT_EVDEV=y
# CONFIG_TOUCHSCREEN_EDT_FT5X06 is not set
# CONFIG_TOUCHSCREEN_GOODIX is not set
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_ALOOP=m
CONFIG_SND_USB_AUDIO=m
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_IPHETH=m
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_GPIO=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_BCM2835AUX=y
CONFIG_SPI=y
CONFIG_SPI_BCM2835=y
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_ISOTP=y
CONFIG_CAN_DEV=y
CONFIG_CAN_CALC_BITTIMING=y
CONFIG_CAN_MCP251X=m
CONFIG_CAN_GS_USB=m
CONFIG_PCIE_BRCMSTB=y
CONFIG_BLK_DEV_NVME=y
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# Real-time clock: restore system time from the RTC at boot (hctosys) and write
# NTP-synced time back to it (systohc). Drivers are built in because hctosys
# runs before modules load. Pi 5 has an on-board RTC (needs the backup battery);
# DS1307/DS3231 covers an optional add-on module on the Pi 4 test rig.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
CONFIG_RTC_DRV_RPI=y
CONFIG_RTC_DRV_DS1307=y
