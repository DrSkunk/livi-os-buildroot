#!/bin/sh

case "$1" in
  start)
    [ ! -e /run/livi-data-failed ] || exit 0
    echo "Starting LIVI kiosk"
    start-stop-daemon -S -b -m -p /run/livi-supervisor.pid -x /usr/bin/livi-supervisor
    ;;
  stop)
    start-stop-daemon -K -p /run/livi-supervisor.pid -R 5
    sync
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
esac
