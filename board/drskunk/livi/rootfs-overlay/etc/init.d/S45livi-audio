#!/bin/sh

run_as_livi() {
  su -s /bin/sh -c "XDG_RUNTIME_DIR=/run/user/1000 HOME=/home/livi $*" livi
}

case "$1" in
  start)
    [ ! -e /run/livi-data-failed ] || exit 0
    echo "Starting LIVI audio session"
    run_as_livi "pipewire >/var/log/pipewire.log 2>&1 &"
    run_as_livi "pipewire-pulse >/var/log/pipewire-pulse.log 2>&1 &"
    run_as_livi "wireplumber >/var/log/wireplumber.log 2>&1 &"
    ;;
  stop)
    killall wireplumber pipewire-pulse pipewire 2>/dev/null || true
    ;;
esac
