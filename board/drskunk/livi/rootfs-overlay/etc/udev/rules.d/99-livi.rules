# LIVI phone/dongle access. Kept on the immutable OS so app updates cannot
# silently expand device privileges.
SUBSYSTEM=="usb", ATTR{idVendor}=="1314", ATTR{idProduct}=="152*", MODE="0660", OWNER="livi"
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ENV{ID_GPHOTO2}="", ENV{GPHOTO2_DRIVER}="none", ENV{UDISKS_IGNORE}="1"
ACTION=="add", SUBSYSTEM=="net", ATTRS{idVendor}=="05ac", RUN+="/sbin/sysctl -qw net.ipv6.conf.%k.accept_dad=0"
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0660", OWNER="livi", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", MODE="0660", OWNER="livi", ENV{UDISKS_IGNORE}="1"
