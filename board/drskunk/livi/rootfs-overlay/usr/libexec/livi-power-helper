#!/bin/sh
set -eu

fail() { echo "livi-power-helper: $*" >&2; exit 2; }
[ "$(/usr/bin/id -u)" = 0 ] || fail "must run as root"
[ "$#" = 1 ] || fail "expected poweroff or reboot"
case "$1" in
  poweroff|reboot) ;;
  *) fail "unsupported power action";;
esac
# Do not queue a reset while an OTA operation is writing inactive slots.
exec 9>/run/livi-os-update.lock
/usr/bin/flock -n 9 || fail "an OS update operation is running"
cd /

# Atomically publish the pending action for LIVI's shutdown overlay.
publish_state() {
  { [ -d /run/livi-power ] || /bin/mkdir -m 0755 /run/livi-power; } &&
    printf '{"state": "%s"}\n' "$1" >/run/livi-power/.state.$$ &&
    /bin/mv -f /run/livi-power/.state.$$ /run/livi-power/state
} 2>/dev/null
publish_state "$1" || echo "livi-power-helper: could not publish power state" >&2

/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
  /usr/bin/systemctl --no-block "$1" || {
  status=$?
  publish_state running || true
  exit "$status"
}
