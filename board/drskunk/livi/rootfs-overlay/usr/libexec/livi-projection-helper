#!/bin/sh
set -eu

fail() { echo "livi-projection-helper: $*" >&2; exit 2; }
[ "$(/usr/bin/id -u)" = 0 ] || fail "must run as root"
[ "$#" = 5 ] || fail "expected AA, CP, public key, pairing ID and debug flag"
case "$1:$2:$5" in
  [01]:[01]:[01]) ;;
  *) fail "wireless and debug flags must be 0 or 1";;
esac
[ "${#3}" = 64 ] || fail "public key must contain 64 hexadecimal characters"
case "$3" in *[!0-9a-fA-F]*) fail "invalid public key";; esac
[ -n "$4" ] && [ "${#4}" -le 64 ] || fail "invalid pairing ID length"
case "$4" in *[!a-zA-Z0-9:-]*) fail "invalid pairing ID";; esac

# No helper command-line switches or inherited environment reach root.
cd /
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
  SUDO_USER=livi LIVI_OS=1 LIVI_OS_API=2 LIVI_LIFELINE=1 \
  LIVI_AA_WIRELESS="$1" LIVI_CP_WIRELESS="$2" LIVI_CP_PK="$3" \
  LIVI_CP_PI="$4" LIVI_CP_DEBUG="$5" DEBUG="$5" \
  /usr/lib/livi/livi-helperd
