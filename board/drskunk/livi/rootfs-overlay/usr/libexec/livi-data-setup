#!/bin/sh
set -eu

[ -e /data/.livi-data ] || { echo "LIVI_DATA marker missing" >&2; exit 1; }
mkdir -p /data/livi/app /data/livi/config /data/livi/cache /data/livi/state /data/livi/log /data/livi/update /data/livi/music \
  /data/os-update /data/games/roms /data/games/saves /data/games/states \
  /data/games/retroarch/cores /data/games/retroarch/playlists /data/games/retroarch/thumbnails /data/games/retroarch/system \
  /data/bluetooth /data/timesync /data/network/system-connections /data/etc/systemd/system \
  /data/lockdown /data/etc/NetworkManager/conf.d \
  /data/etc/bluetooth /data/etc/minidsp /data/etc/udev/rules.d /run/user/1000

mkdir -p /data/livi/config/LIVI
if [ ! -e /data/livi/config/LIVI/config.json ] && [ ! -e /data/livi/config/config.json.last-good ]; then
  password="$(openssl rand -hex 16)"
  seed="$(mktemp /data/livi/config/LIVI/.config.XXXXXX)"
  trap 'rm -f "$seed"' EXIT
  jq -en --slurpfile defaults /usr/share/livi/config-default.json --arg password "$password" \
    '$defaults[0] + {wifiPassword: $password, country: "CA", mainScreenWidth: 1280, mainScreenHeight: 400, kiosk: {main: true, dash: false, aux: false}}' > "$seed"
  sync
  mv "$seed" /data/livi/config/LIVI/config.json
  sync
  trap - EXIT
fi

# One interpreter start for all directories instead of one per directory.
set --
for entry in \
  /etc/bluetooth:/data/etc/bluetooth:bluetooth \
  /etc/minidsp:/data/etc/minidsp:minidsp \
  /etc/udev/rules.d:/data/etc/udev/rules.d:udev \
  /etc/systemd/system:/data/etc/systemd/system:systemd \
  /etc/NetworkManager/conf.d:/data/etc/NetworkManager/conf.d:NetworkManager \
  /usr/share/livi/games:/data/games:games; do
  source="${entry%%:*}" rest="${entry#*:}"
  destination="${rest%%:*}" name="${rest#*:}"
  [ "$name" != games ] || [ -d "$source" ] || continue
  mountpoint -q "$source" || set -- "$@" "$source" "$destination" "/data/etc-defaults/$name"
done
[ "$#" -eq 0 ] || /usr/libexec/livi-merge-defaults "$@"
/usr/libexec/livi-retroarch-setup

# Reloading systemd takes long and stalls every queued job; only do it when the
# persistent unit directory differs from the units systemd already loaded.
reload_units=1
if ! mountpoint -q /etc/systemd/system &&
  /usr/libexec/livi-merge-defaults --identical /etc/systemd/system /data/etc/systemd/system; then
  reload_units=0
fi

mountpoint -q /var/lib/bluetooth || mount --bind /data/bluetooth /var/lib/bluetooth
# systemd-timesyncd keeps its last-synced clock here; persisted so an offline
# boot without RTC starts from the last known time instead of the build date.
mountpoint -q /var/lib/systemd/timesync || mount --bind /data/timesync /var/lib/systemd/timesync
mountpoint -q /var/lib/lockdown || mount --bind /data/lockdown /var/lib/lockdown
mountpoint -q /etc/bluetooth || mount --bind /data/etc/bluetooth /etc/bluetooth
mountpoint -q /etc/minidsp || mount --bind /data/etc/minidsp /etc/minidsp
mountpoint -q /etc/udev/rules.d || mount --bind /data/etc/udev/rules.d /etc/udev/rules.d
mountpoint -q /etc/systemd/system || mount --bind /data/etc/systemd/system /etc/systemd/system
mountpoint -q /etc/NetworkManager/system-connections || \
  mount --bind /data/network/system-connections /etc/NetworkManager/system-connections
mountpoint -q /etc/NetworkManager/conf.d || \
  mount --bind /data/etc/NetworkManager/conf.d /etc/NetworkManager/conf.d

ln -snf /data/games/retroarch /data/livi/config/retroarch
# Recursive chown rewrites every inode (ROMs, music) on each boot; touch only
# entries whose ownership is actually wrong. -h matches chown -R's lchown.
find /data/livi /data/games /run/user/1000 \( ! -user livi -o ! -group livi \) \
  -exec chown -h livi:livi {} +
chmod 0700 /run/user/1000 /data/network/system-connections
chmod 0700 /data/lockdown
chmod 0750 /data/livi/app /data/livi/config /data/livi/update

# Re-read migrated units/rules after mounting their persistent directories.
[ "$reload_units" = 0 ] || systemctl daemon-reload
udevadm control --reload
