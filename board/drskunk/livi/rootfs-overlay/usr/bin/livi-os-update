#!/bin/sh
set -eu

ROOT_A=8d9f2f13-5a82-4fd8-93e7-88e7ea6118d2
ROOT_B=4af7b146-2c77-4808-881b-1e3ad8d15be8
STATE=/data/os-update
image="${1:?usage: livi-os-update ROOTFS.squashfs SIGNATURE}"
signature="${2:?usage: livi-os-update ROOTFS.squashfs SIGNATURE}"
key="$STATE/trusted.pem"
mkdir -p "$STATE"
exec 9>/run/livi-os-update.lock
flock -n 9 || { echo "Another OS update is running" >&2; exit 1; }
[ ! -f "$STATE/pending" ] || { echo "Confirm or cancel the pending update first" >&2; exit 1; }

if [ ! -f "$image" ] || [ ! -f "$signature" ]; then
  echo "Image or signature missing" >&2
  exit 1
fi
# Verify and write a private snapshot, so the caller cannot change the file
# between signature verification and the block-device write.
work="$(mktemp -d "$STATE/install.XXXXXX")"
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cp --reflink=auto "$image" "$work/rootfs.squashfs"
cp "$signature" "$work/rootfs.sig"
image="$work/rootfs.squashfs"
signature="$work/rootfs.sig"
[ -f "$key" ] || { echo "Provision $key before OS updates" >&2; exit 1; }
[ "$(od -An -tx1 -N4 "$image" | tr -d ' \n')" = 68737173 ] || { echo "Not a SquashFS image" >&2; exit 1; }
openssl dgst -sha256 -verify "$key" -signature "$signature" "$image"
# The boot partition is shared. Reject roots built for another kernel/board.
installed_boot="$(cat /usr/lib/livi/boot-id)"
candidate_boot="$(unsquashfs -cat "$image" usr/lib/livi/boot-id)"
if [ -z "$installed_boot" ] || [ "$candidate_boot" != "$installed_boot" ]; then
  echo "Boot artifacts differ; this update requires a full-image installation" >&2
  exit 1
fi

current="$(livi-os-slot current)"
[ "$(livi-os-slot default)" = "$current" ] || {
  echo "Confirm the running trial before installing another OS update" >&2; exit 1;
}
case "$current" in
  "$ROOT_A") target="$ROOT_B";;
  "$ROOT_B") target="$ROOT_A";;
  *) echo "Unknown current root slot: $current" >&2; exit 1;;
esac
device="$(readlink -f "/dev/disk/by-partuuid/$target")"
[ -b "$device" ] || { echo "Inactive root device not found" >&2; exit 1; }
image_size="$(stat -c %s "$image")"
device_size="$(blockdev --getsize64 "$device")"
[ "$image_size" -le "$device_size" ] || { echo "Image exceeds root slot" >&2; exit 1; }

echo "Writing verified OS image to inactive slot $target"
dd if="$image" of="$device" bs=4M conv=fsync
expected="$(sha256sum "$image" | awk '{print $1}')"
actual="$(head -c "$image_size" "$device" | sha256sum | awk '{print $1}')"
[ "$actual" = "$expected" ] || { echo "Inactive-slot readback verification failed" >&2; exit 1; }

livi-os-slot stage "$target" "$expected"
echo "OS staged. Run livi-os-slot reboot to test it once; ordinary reboot keeps the previous root."
