#!/bin/sh
set -eu

ROOT_A=8d9f2f13-5a82-4fd8-93e7-88e7ea6118d2
ROOT_B=4af7b146-2c77-4808-881b-1e3ad8d15be8
BOOT_A=2
BOOT_B=3
STATE=/data/os-update
PENDING="$STATE/pending"
AUTOBOOT=/boot/autoboot.txt

current_uuid() {
  sed -n 's/.*root=PARTUUID=\([^ ]*\).*/\1/p' /proc/cmdline | tr 'A-F' 'a-f'
}
valid_slot() {
  case "$1" in "$ROOT_A"|"$ROOT_B") return 0;; *) echo "Invalid root slot UUID" >&2; return 1;; esac
}
root_for_boot() {
  case "$1" in
    "$BOOT_A") printf '%s\n' "$ROOT_A";;
    "$BOOT_B") printf '%s\n' "$ROOT_B";;
    *) echo "Invalid boot partition: $1" >&2; return 1;;
  esac
}
boot_for_root() {
  case "$1" in
    "$ROOT_A") printf '%s\n' "$BOOT_A";;
    "$ROOT_B") printf '%s\n' "$BOOT_B";;
    *) echo "Invalid root slot UUID" >&2; return 1;;
  esac
}
autoboot_partition() {
  section="$1"
  partition="$(awk -v wanted="[$section]" '
    $0 == wanted { active=1; next }
    /^\[/ { active=0 }
    active && /^boot_partition=/ { sub(/^boot_partition=/, ""); print; exit }
  ' "$AUTOBOOT")"
  case "$partition" in "$BOOT_A"|"$BOOT_B") printf '%s\n' "$partition";;
    *) echo "Invalid or missing [$section] boot_partition in $AUTOBOOT" >&2; return 1;;
  esac
}
bootloader_value() {
  name="$1"
  path="/proc/device-tree/chosen/bootloader/$name"
  [ -r "$path" ] || { echo "Bootloader property $name is unavailable" >&2; return 1; }
  raw="$(od -An -v -tx1 "$path" | tr -d ' \n')"
  case "$raw" in ''|*[!0-9a-fA-F]*) echo "Invalid bootloader property $name" >&2; return 1;; esac
  [ "${#raw}" -eq 8 ] || { echo "Invalid bootloader property $name" >&2; return 1; }
  printf '%d\n' "0x$raw"
}
current_boot_partition() { bootloader_value partition; }
current_uuid_for_boot() { root_for_boot "$(current_boot_partition)"; }
default_uuid() { root_for_boot "$(autoboot_partition all)"; }
is_trial() {
  [ "$(bootloader_value tryboot 2>/dev/null || echo 0)" = 1 ]
}
write_autoboot() {
  default="$1" trial="$2"
  case "$default" in "$BOOT_A"|"$BOOT_B");; *) echo "Invalid default boot partition" >&2; return 1;; esac
  case "$trial" in "$BOOT_A"|"$BOOT_B");; *) echo "Invalid trial boot partition" >&2; return 1;; esac
  [ "$default" != "$trial" ] || { echo "Default and trial boot partitions must differ" >&2; return 1; }
  mount -o remount,rw /boot
  trap 'mount -o remount,ro /boot 2>/dev/null || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  printf '[all]\ntryboot_a_b=1\nboot_partition=%s\n[tryboot]\nboot_partition=%s\n' \
    "$default" "$trial" > "$AUTOBOOT.new"
  sync
  mv -f "$AUTOBOOT.new" "$AUTOBOOT"
  sync
  mount -o remount,ro /boot
  trap - EXIT INT TERM
}

trial_reboot() {
  target="$(sed -n '1p' "$PENDING")"
  previous="$(sed -n '2p' "$PENDING")"
  valid_slot "$target"
  valid_slot "$previous"
  [ "$(current_uuid)" = "$previous" ] || { echo "Not running the previous root" >&2; exit 1; }
  [ "$(current_boot_partition)" = "$(autoboot_partition all)" ] ||
    { echo "Not running the default boot partition" >&2; exit 1; }
  [ "$(boot_for_root "$target")" = "$(autoboot_partition tryboot)" ] ||
    { echo "The staged update is not the configured tryboot partition" >&2; exit 1; }
  sed '3s/.*/1/' "$PENDING" > "$PENDING.new"
  sync
  mv -f "$PENDING.new" "$PENDING"
  sync
  reboot '0 tryboot'
}

# These commands must work even when /data cannot mount during a trial boot.
case "${1:-}" in
  current) current_uuid; exit 0;;
  default) default_uuid; exit 0;;
  boot-failed|boot-timeout)
    if is_trial && [ ! -e /run/livi-os-confirmed ]; then
      echo "Unconfirmed trial failed; rebooting to the unchanged default root" >&2
      reboot -f
    fi
    exit 0
    ;;
esac

mkdir -p "$STATE"
exec 8>/run/livi-os-slot.lock
flock -x 8
case "${1:-}" in
  stage)
    target="${2:?slot UUID required}"
    expected="${3:?image hash required}"
    valid_slot "$target"
    current="$(current_uuid)"
    valid_slot "$current"
    [ "$(default_uuid)" = "$current" ] || { echo "Confirm the active trial before staging another root" >&2; exit 1; }
    [ "$current" != "$target" ] || { echo "Refusing to stage the active root" >&2; exit 1; }
    [ "$(boot_for_root "$target")" = "$(autoboot_partition tryboot)" ] ||
      { echo "Target root does not match the configured tryboot partition" >&2; exit 1; }
    [ "$(autoboot_partition all)" != "$(autoboot_partition tryboot)" ] ||
      { echo "Default and tryboot boot partitions must differ" >&2; exit 1; }
    [ ! -e "$PENDING" ] || { echo "An OS update is already pending" >&2; exit 1; }
    printf '%s\n%s\n0\n%s\n' "$target" "$current" "$expected" > "$PENDING.new"
    sync
    mv -f "$PENDING.new" "$PENDING"
    sync
    ;;
  reboot)
    [ -f "$PENDING" ] || { echo "No staged update" >&2; exit 1; }
    trial_reboot
    ;;
  apply-pending)
    [ -f "$PENDING" ] || exit 0
    [ "$(sed -n '3p' "$PENDING")" = 0 ] || exit 0
    if is_trial; then exit 0; fi
    echo "Trying the staged OS update" >&2
    trial_reboot
    ;;
  boot-check)
    [ -f "$PENDING" ] || exit 0
    target="$(sed -n '1p' "$PENDING")"
    previous="$(sed -n '2p' "$PENDING")"
    attempted="$(sed -n '3p' "$PENDING")"
    current="$(current_uuid)"
    current_boot="$(current_boot_partition)"
    valid_slot "$target"
    valid_slot "$previous"
    if [ "$current" = "$previous" ] && [ "$attempted" = 1 ]; then
      [ "$current_boot" = "$(autoboot_partition all)" ] ||
        { echo "Returned to the previous root from the wrong boot partition" >&2; exit 1; }
      mv -f "$PENDING" "$STATE/failed-$(date +%s)"
      sync
      echo "Returned to previous root after unconfirmed trial" >&2
    elif [ "$current" = "$target" ]; then
      is_trial || { echo "Candidate did not boot through tryboot" >&2; exit 1; }
      [ "$current_boot" = "$(boot_for_root "$target")" ] &&
        [ "$current_boot" = "$(autoboot_partition tryboot)" ] ||
        { echo "Candidate booted from the wrong boot partition" >&2; exit 1; }
    fi
    ;;
  mark-good)
    if [ -f "$PENDING" ]; then
      current="$(current_uuid)"
      [ "$current" = "$(sed -n '1p' "$PENDING")" ] || exit 0
      is_trial || { echo "Refusing to commit a non-trial candidate" >&2; exit 1; }
      current_boot="$(current_boot_partition)"
      [ "$current_boot" = "$(boot_for_root "$current")" ] &&
        [ "$current_boot" = "$(autoboot_partition tryboot)" ] ||
        { echo "Refusing to commit a candidate from the wrong boot partition" >&2; exit 1; }
      default_boot="$(autoboot_partition all)"
      write_autoboot "$current_boot" "$default_boot"
      printf '%s\n' "$current" > "$STATE/good-slot.new"
      sync
      mv -f "$STATE/good-slot.new" "$STATE/good-slot"
      rm -f "$PENDING"
      sync
    fi
    touch /run/livi-os-confirmed
    ;;
  cancel)
    [ -f "$PENDING" ] || exit 0
    [ "$(current_uuid)" != "$(sed -n '1p' "$PENDING")" ] || {
      echo "Reboot to the previous root before cancelling a running trial" >&2; exit 1;
    }
    mv -f "$PENDING" "$STATE/cancelled-$(date +%s)"
    sync
    ;;
  *)
    echo "usage: livi-os-slot {current|default|stage UUID HASH|reboot|apply-pending|boot-check|boot-failed|boot-timeout|mark-good|cancel}" >&2
    exit 2
    ;;
esac
