#!/bin/sh

CONFIG=/data/livi/config/LIVI/config.json
BACKUP=/data/livi/config/config.json.last-good
DEFAULT=/usr/share/livi/config-default.json

valid() { [ -s "$1" ] && jq -e 'type == "object"' "$1" >/dev/null 2>&1; }
backup() {
  valid "$CONFIG" || return 0
  cmp -s "$CONFIG" "$BACKUP" 2>/dev/null && return 0
  cp "$CONFIG" "$BACKUP.new" && sync && mv -f "$BACKUP.new" "$BACKUP" && sync
}
restore() {
  if ! valid "$CONFIG" && valid "$BACKUP"; then
    echo "Restoring last-known-good LIVI config" >&2
    mkdir -p "$(dirname "$CONFIG")" && chown livi:livi "$(dirname "$CONFIG")" &&
      cp "$BACKUP" "$CONFIG.new" && chown livi:livi "$CONFIG.new" &&
      chmod 0600 "$CONFIG.new" && sync && mv -f "$CONFIG.new" "$CONFIG" && sync
  fi
}

initialize() (
  if [ -e "$CONFIG" ] || [ -L "$CONFIG" ] || [ -e "$BACKUP" ] || [ -L "$BACKUP" ]; then
    exit 0
  fi
  if ! valid "$DEFAULT"; then
    echo "Missing or invalid LIVI configuration defaults: $DEFAULT" >&2
    exit 1
  fi
  umask 077
  mkdir -p "$(dirname "$CONFIG")" || exit 1
  temporary="$(mktemp "${CONFIG}.new.XXXXXX")" || exit 1
  trap 'rm -f "$temporary"' 0
  if ! cp "$DEFAULT" "$temporary" || ! chmod 0600 "$temporary" ||
      ! sync || ! ln "$temporary" "$CONFIG" || ! rm -f "$temporary" || ! sync; then
    echo "Failed to install LIVI configuration defaults: $CONFIG" >&2
    exit 1
  fi
  trap - 0
  echo "Initialized LIVI display defaults"
)

case "${1:-}" in
  restore) restore ;;
  initialize) initialize ;;
  watch) while sleep 5; do backup; done ;;
  backup) backup ;;
  *) echo "usage: livi-config-guard {restore|initialize|watch|backup}" >&2; exit 2 ;;
esac
