[Unit]
OnFailure=livi-boot-failed.service
Description=PipeWire for LIVI
Requires=livi-data-setup.service
After=livi-data-setup.service dbus.service

[Service]
User=livi
Environment=HOME=/home/livi
Environment=XDG_STATE_HOME=/data/livi/state
Environment=XDG_CACHE_HOME=/data/livi/cache
Environment=XDG_CONFIG_HOME=/data/livi/config
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/pipewire
Restart=on-failure

[Install]
WantedBy=multi-user.target
