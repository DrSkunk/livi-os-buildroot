[Unit]
OnFailure=livi-boot-failed.service
Description=LIVI automotive kiosk with update rollback
Requires=livi-data-setup.service livi-os-slot.service livi-pipewire.service livi-pipewire-pulse.service livi-wireplumber.service seatd.service
After=livi-data-setup.service livi-os-slot.service livi-pipewire.service livi-pipewire-pulse.service livi-wireplumber.service seatd.service livi-can.service
Conflicts=getty@tty1.service livi-splash.service
After=livi-splash.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=livi
Group=livi
ExecStart=/usr/bin/livi-supervisor
Restart=always
RestartSec=3
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
