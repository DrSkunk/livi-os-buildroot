LIBRETRO_MGBA_VERSION = 082fc8abb0d81db9bb84678b063c894d4e082caa
LIBRETRO_MGBA_SITE = $(call github,libretro,mgba,$(LIBRETRO_MGBA_VERSION))
LIBRETRO_MGBA_LICENSE = MPL-2.0
LIBRETRO_MGBA_LICENSE_FILES = LICENSE
LIBRETRO_MGBA_DEPENDENCIES = zlib
LIBRETRO_MGBA_CONF_OPTS = -DBUILD_LIBRETRO=ON -DSKIP_LIBRARY=ON \
	-DBUILD_QT=OFF -DBUILD_SDL=OFF -DBUILD_GL=OFF -DBUILD_GLES2=OFF \
	-DBUILD_GLES3=OFF -DUSE_FFMPEG=OFF -DUSE_PNG=OFF -DUSE_SQLITE3=OFF \
	-DUSE_LUA=OFF -DUSE_ZLIB=ON

define LIBRETRO_MGBA_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/mgba_libretro.so $(TARGET_DIR)/usr/lib/libretro/mgba_libretro.so
endef
$(eval $(cmake-package))
