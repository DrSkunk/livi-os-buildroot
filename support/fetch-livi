#!/bin/sh
set -eu

repo="${1:-DrSkunk/LIVI}"
channel="${2:-stable}"
destination="${3:-artifacts/LIVI-arm64.AppImage}"

case "$channel" in
  stable) api="https://api.github.com/repos/$repo/releases/latest" ;;
  nightly) api="https://api.github.com/repos/$repo/releases/tags/nightly" ;;
  *) echo "channel must be stable or nightly" >&2; exit 2 ;;
esac

tmp_json="$(mktemp)"
tmp_image="$(mktemp)"
trap 'rm -f "$tmp_json" "$tmp_image"' EXIT
curl -fsSL -H 'Accept: application/vnd.github+json' "$api" -o "$tmp_json"
url="$(sed -n 's/.*"browser_download_url": *"\([^"]*\(arm64\|aarch64\)\.AppImage\)".*/\1/p' "$tmp_json" | head -1)"
[ -n "$url" ] || { echo "No ARM64 AppImage in $channel release of $repo" >&2; exit 1; }

echo "Downloading $url"
curl -fL --retry 3 "$url" -o "$tmp_image"
magic="$(dd if="$tmp_image" bs=1 skip=8 count=3 2>/dev/null | od -An -tx1 | tr -d ' \n')"
[ "$magic" = 414902 ] || { echo "Downloaded file is not an AppImage type 2 payload" >&2; exit 1; }
machine="$(readelf -h "$tmp_image" 2>/dev/null | sed -n 's/^ *Machine: *//p')"
case "$machine" in AArch64*) ;; *) echo "Unexpected AppImage architecture: $machine" >&2; exit 1;; esac
root="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
python3 -c 'import pathlib, runpy, sys; runpy.run_path(sys.argv[1])["check_appimage"](pathlib.Path(sys.argv[2]))' \
  "$root/support/check-rust-payload" "$tmp_image"
mkdir -p "$(dirname "$destination")"
chmod 0755 "$tmp_image"
mv "$tmp_image" "$destination"
sha256sum "$destination" > "$destination.sha256"
echo "Saved $destination"
